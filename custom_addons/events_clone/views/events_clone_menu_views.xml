<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Actions -->
        <record id="action_events_clone_event" model="ir.actions.act_window">
            <field name="name">Events Clone</field>
            <field name="res_model">events.clone.event</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="path">events-clone</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create an Event
                </p>
                <p>
                    Schedule and organize your events: handle registrations, manage tickets, and track attendees.
                </p>
            </field>
        </record>

        <record id="action_events_clone_registration" model="ir.actions.act_window">
            <field name="name">Registrations</field>
            <field name="res_model">events.clone.registration</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_confirmed': 1}</field>
        </record>

        <record id="action_events_clone_ticket" model="ir.actions.act_window">
            <field name="name">Event Tickets</field>
            <field name="res_model">events.clone.ticket</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_events_clone_stage" model="ir.actions.act_window">
            <field name="name">Event Stages</field>
            <field name="res_model">events.clone.stage</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_events_clone_tag" model="ir.actions.act_window">
            <field name="name">Event Tags</field>
            <field name="res_model">events.clone.tag</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_events_clone_tag_category" model="ir.actions.act_window">
            <field name="name">Event Tag Categories</field>
            <field name="res_model">events.clone.tag.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Main Menu -->
        <menuitem id="menu_events_clone_root"
                  name="Events Clone"
                  sequence="75"
                  web_icon="events_clone,static/description/icon.png"/>

        <!-- Events Menu -->
        <menuitem id="menu_events_clone_events"
                  name="Events"
                  parent="menu_events_clone_root"
                  sequence="10"/>

        <menuitem id="menu_events_clone_event_main"
                  name="Events"
                  parent="menu_events_clone_events"
                  action="action_events_clone_event"
                  sequence="10"/>

        <menuitem id="menu_events_clone_registration"
                  name="Registrations"
                  parent="menu_events_clone_events"
                  action="action_events_clone_registration"
                  sequence="20"/>

        <!-- Configuration Menu -->
        <menuitem id="menu_events_clone_configuration"
                  name="Configuration"
                  parent="menu_events_clone_root"
                  sequence="100"
                  groups="events_clone.group_events_clone_manager"/>

        <menuitem id="menu_events_clone_stage_config"
                  name="Stages"
                  parent="menu_events_clone_configuration"
                  action="action_events_clone_stage"
                  sequence="10"/>

        <menuitem id="menu_events_clone_tag_category_config"
                  name="Tag Categories"
                  parent="menu_events_clone_configuration"
                  action="action_events_clone_tag_category"
                  sequence="20"/>

        <menuitem id="menu_events_clone_tag_config"
                  name="Tags"
                  parent="menu_events_clone_configuration"
                  action="action_events_clone_tag"
                  sequence="30"/>
    </data>
</odoo>

