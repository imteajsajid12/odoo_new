<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Event Stages -->
        <record id="stage_new" model="events.clone.stage">
            <field name="name">New</field>
            <field name="sequence">1</field>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_confirmed" model="events.clone.stage">
            <field name="name">Confirmed</field>
            <field name="sequence">2</field>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_in_progress" model="events.clone.stage">
            <field name="name">In Progress</field>
            <field name="sequence">3</field>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_done" model="events.clone.stage">
            <field name="name">Done</field>
            <field name="sequence">4</field>
            <field name="fold" eval="True"/>
            <field name="pipe_end" eval="True"/>
        </record>

        <record id="stage_cancelled" model="events.clone.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">5</field>
            <field name="fold" eval="True"/>
        </record>

        <!-- Event Tag Categories -->
        <record id="tag_category_type" model="events.clone.tag.category">
            <field name="name">Event Type</field>
            <field name="sequence">1</field>
        </record>

        <record id="tag_category_topic" model="events.clone.tag.category">
            <field name="name">Topic</field>
            <field name="sequence">2</field>
        </record>

        <!-- Event Tags -->
        <record id="tag_conference" model="events.clone.tag">
            <field name="name">Conference</field>
            <field name="category_id" ref="tag_category_type"/>
            <field name="color">1</field>
        </record>

        <record id="tag_seminar" model="events.clone.tag">
            <field name="name">Seminar</field>
            <field name="category_id" ref="tag_category_type"/>
            <field name="color">2</field>
        </record>

        <record id="tag_workshop" model="events.clone.tag">
            <field name="name">Workshop</field>
            <field name="category_id" ref="tag_category_type"/>
            <field name="color">3</field>
        </record>

        <record id="tag_training" model="events.clone.tag">
            <field name="name">Training</field>
            <field name="category_id" ref="tag_category_type"/>
            <field name="color">4</field>
        </record>

        <record id="tag_technology" model="events.clone.tag">
            <field name="name">Technology</field>
            <field name="category_id" ref="tag_category_topic"/>
            <field name="color">5</field>
        </record>

        <record id="tag_business" model="events.clone.tag">
            <field name="name">Business</field>
            <field name="category_id" ref="tag_category_topic"/>
            <field name="color">6</field>
        </record>

        <record id="tag_marketing" model="events.clone.tag">
            <field name="name">Marketing</field>
            <field name="category_id" ref="tag_category_topic"/>
            <field name="color">7</field>
        </record>
    </data>
</odoo>

